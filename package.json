{
  "name": "strapi-playground",
  "private": true,
  "version": "0.1.1",
  "description": "Strapi Playground for testing features",
  "scripts": {
    "start:dev": "ENV_PATH=.env.dev strapi develop",
    "build:dev": "ENV_PATH=.env.dev strapi build",
    "start:supabase": "ENV_PATH=.env.supabase strapi develop",
    "build:supabase": "ENV_PATH=.env.supabase strapi build",
    "start:prod": "ENV_PATH=.env.prod NODE_ENV=production strapi start",
    "build:prod": "ENV_PATH=.env.prod NODE_ENV=production strapi build",
    "strapi": "strapi",
    "nuke": "rm -r node_modules; for d in node_modules; do echo $d; rm -r $d; done",
    "build:docker": "docker build -t strapi-playground-prod:v1.0 -f Dockerfile .",
    "docker:dev": "docker compose -f docker-compose-dev.yml --env-file .env.dev up -d",
    "stop:docker:dev": "docker compose -f docker-compose-dev.yml --env-file .env.dev down",
    "stop:docker:dev:cleanup": "docker compose -f docker-compose-dev.yml --env-file .env.dev down --volumes",
    "docker:prod": "docker compose -f docker-compose.yml --env-file .env.prod up -d",
    "stop:docker:prod": "docker compose -f docker-compose.yml --env-file .env.prod down",
    "stop:docker:prod:cleanup": "docker compose -f docker-compose.yml down --volumes"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "^5"
  },
  "dependencies": {
    "@strapi/email": "5.11.2",
    "@strapi/plugin-documentation": "5.11.2",
    "@strapi/plugin-graphql": "5.11.2",
    "@strapi/plugin-users-permissions": "5.11.2",
    "@strapi/strapi": "5.11.2",
    "@strapi/upload": "5.11.2",
    "pg": "8.8.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "strapi-plugin-config-sync": "3.1.1",
    "styled-components": "^6.0.0"
  },
  "author": {
    "name": "mrpitch"
  },
  "strapi": {
    "uuid": "0355bba6-96a0-42c4-81cd-3c6cccaf25fa"
  },
  "engines": {
    "node": ">=18.x.x <=20.x.x"
  },
  "license": "MIT"
}
